if SHIELD_LISM_L || SHIELD_LISM_R
    config ZMK_KEYBOARD_NAME
        default "LisM"

    config NFCT_PINS_AS_GPIOS
        default y

    config ZMK_SPLIT
        default y

    config ZMK_POINTING
        default y

    config ZMK_MOUSE
        default y
    
    config PAW3222
        default y
    
    config INPUT
        default y
    
    config SPI
        default y
endif
config ZMK_BT_RECOVERY
    default y if ZMK_ZEROSHIFT && ZMK_SPLIT_BLE && !ZMK_SETTINGS_RESET_ON_START

config ZMK_BT_RECOVERY_DIAGNOSTICS
    default y if ZMK_BT_RECOVERY
